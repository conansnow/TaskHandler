root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Matches .clang-format, which is the authority for these.
[*.{h,cc}]
indent_size = 2
max_line_length = 80

[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# Two trailing spaces are a line break in Markdown, so leave them alone.
[*.md]
trim_trailing_whitespace = false
max_line_length = 80
