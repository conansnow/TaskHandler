prefix=${pcfiledir}/@TASKHANDLER_PC_PREFIX_FROM_PKGCONFIG@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: taskhandler
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Cflags: -I${includedir}@TASKHANDLER_PC_CFLAGS@
Libs: -L${libdir} @TASKHANDLER_PC_LIBS@
